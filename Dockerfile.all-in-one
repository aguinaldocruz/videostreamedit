# Build the normal image first: docker compose build videostreamedit
# This optional image inherits all current application tools and fixes.
FROM videostreamedit:local
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-18 \
    && pg_dropcluster --stop 18 main \
    && rm -rf /var/lib/apt/lists/*
COPY tools/all_in_one.py /app/tools/all_in_one.py
ENV PYTHONPATH=/app
VOLUME ["/config", "/data", "/backup"]
ENTRYPOINT ["python", "/app/tools/all_in_one.py"]
CMD []
